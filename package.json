{
  "name": "opencode-dpsk-search",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.0",
  "description": "OpenCode plugin that replaces the built-in websearch tool with one backed by DeepSeek's server-side web search.",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "deepseek",
    "web-search"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./server": "./index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "prepack": "pnpm build",
    "release": "bumpp -r"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@opencode/plugin": "^2.0.26",
    "@types/bun": "^1.4.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
